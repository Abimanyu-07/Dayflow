generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model attendance {
  id            String    @id @default(uuid()) @db.Uuid
  employee_id   String    @db.Uuid
  date          DateTime  @db.Date
  check_in      DateTime? @db.Timestamp(6)
  check_out     DateTime? @db.Timestamp(6)
  status        String    @db.VarChar(20)
  working_hours Decimal?  @db.Decimal(5, 2)
  notes         String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  employees     employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, map: "fk_attendance_employee_id")

  @@unique([employee_id, date], map: "uq_attendance_employee_date")
}

model departments {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique @db.VarChar(100)
  description String?
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  updated_at  DateTime?   @default(now()) @db.Timestamp(6)
  employees   employees[]
}

model employees {
  id            String       @id @default(uuid()) @db.Uuid
  user_id       String       @unique @db.Uuid
  employee_code String       @unique @db.VarChar(50)
  first_name    String       @db.VarChar(100)
  last_name     String?      @db.VarChar(100)
  phone         String?      @db.VarChar(20)
  department_id String?      @db.Uuid
  designation   String?      @db.VarChar(100)
  joining_date  DateTime?    @db.Date
  salary        Decimal?     @db.Decimal(12, 2)
  profile_image String?
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  updated_at    DateTime?    @default(now()) @db.Timestamp(6)
  attendance    attendance[]
  departments   departments? @relation(fields: [department_id], references: [id], map: "fk_employees_department_id")
  users         users        @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_employees_user_id")
  leaves        leaves[]
  payroll       payroll[]
}

model leave_types {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(50)
  description String?
  max_days    Int
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  leaves      leaves[]
}

model leaves {
  id            String      @id @default(uuid()) @db.Uuid
  employee_id   String      @db.Uuid
  leave_type_id String      @db.Uuid
  start_date    DateTime    @db.Date
  end_date      DateTime    @db.Date
  reason        String?
  status        String      @default("PENDING") @db.VarChar(20)
  approved_by   String?     @db.Uuid
  approved_at   DateTime?   @db.Timestamp(6)
  admin_comment String?
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  updated_at    DateTime?   @default(now()) @db.Timestamp(6)
  users         users?      @relation(fields: [approved_by], references: [id], map: "fk_leaves_approved_by")
  employees     employees   @relation(fields: [employee_id], references: [id], onDelete: Cascade, map: "fk_leaves_employee_id")
  leave_types   leave_types @relation(fields: [leave_type_id], references: [id], map: "fk_leaves_leave_type_id")
}

model notifications {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  title      String    @db.VarChar(255)
  message    String
  type       String?   @db.VarChar(50)
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notifications_user_id")
}

model payroll {
  id           String    @id @default(uuid()) @db.Uuid
  employee_id  String    @db.Uuid
  month        Int
  year         Int
  basic_salary Decimal   @db.Decimal(12, 2)
  allowances   Decimal?  @default(0) @db.Decimal(12, 2)
  deductions   Decimal?  @default(0) @db.Decimal(12, 2)
  net_salary   Decimal   @db.Decimal(12, 2)
  status       String    @default("PENDING") @db.VarChar(20)
  generated_at DateTime? @db.Timestamp(6)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  employees    employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, map: "fk_payroll_employee_id")

  @@unique([employee_id, month, year], map: "uq_payroll_employee_month_year")
}

model users {
  id                 String          @id @default(uuid()) @db.Uuid
  email              String          @unique @db.VarChar(255)
  password_hash      String          @db.VarChar(255)
  role               String          @db.VarChar(20)
  is_active          Boolean         @default(true)
  is_verified        Boolean         @default(false)
  verification_token String?         @db.VarChar(255)
  created_at         DateTime?       @default(now()) @db.Timestamp(6)
  updated_at         DateTime?       @default(now()) @db.Timestamp(6)
  employees          employees?
  leaves             leaves[]
  notifications      notifications[]
}
